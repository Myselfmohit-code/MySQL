Que 1. find Second highest salary 
  
select max(sal) from emp 
where sal < (select max (sal) from emp);

Que 2. department wise highest salary

select max(sal),deptno
from emp
group by deptno

select min(sal),deptno
from emp
group by deptno 

Que 3.display  duplicate in a column 

select ename,count(*) 
from emp 
group by ename
having count(*)>1; 

Que 4. Display all employees earning more than 40,000.

select * from emply
where salary > 40000;

Que 5. Find the average salary. 

 SELECT AVG(salary) FROM Employee 

Que 6.Find duplicate salaries.

SELECT salary, COUNT(*) FROM Employee GROUP BY salary HAVING COUNT(*) > 1;
